# Existing server settings are omitted here; copy the values from your deployment.
MONGOOSE_URL=mongodb://localhost:27017/appdb
FRONTEND_URL=http://localhost:5173

# Razorpay checkout and signed webhook recovery.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Must match server/ai-agent-backend/.env and must never be exposed to Vite.
WHATSAPP_COMMERCE_KEY=

# Meta Cloud API credentials used for transactional order updates.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=
WHATSAPP_TEMPLATE_PAYMENT_FAILED=
WHATSAPP_TEMPLATE_ORDER_READY=
WHATSAPP_TEMPLATE_ORDER_SHIPPED=
WHATSAPP_TEMPLATE_ORDER_DELIVERED=
WHATSAPP_TEMPLATE_ORDER_CANCELLED=
WHATSAPP_TEMPLATE_REFUND_PROCESSING=
WHATSAPP_TEMPLATE_REFUND_PAID=
WHATSAPP_TEMPLATE_REFUND_FAILED=
