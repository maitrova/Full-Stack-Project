APP_NAME="AI Sales Employee API"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api

# Optional override. If omitted, MONGOOSE_URL from ../.env is reused.
# MONGODB_URL=mongodb://localhost:27017/appdb
MONGODB_DB_NAME=appdb

# Live MERN ecommerce database (server/.env MONGOOSE_URL and its database name)
ECOMMERCE_MONGODB_URL=mongodb://localhost:27017/appdb
ECOMMERCE_MONGODB_DB_NAME=appdb
# Public HTTPS origin serving /api/outputs/... product images (no trailing /api)
ECOMMERCE_PUBLIC_URL=https://api.yourstore.com
# Customer-facing website origin for product links (different from image/API origin).
ECOMMERCE_STOREFRONT_URL=https://www.yourstore.com

JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Meta app secret; required to validate incoming POST webhooks.
WHATSAPP_APP_SECRET=
# Set the SAME random server-to-server secret here and in server/.env.
WHATSAPP_COMMERCE_KEY=
# Must target the backend used by ECOMMERCE_STOREFRONT_URL.
# For a deployed storefront, replace this local URL with its deployed API URL.
ECOMMERCE_API_URL=http://127.0.0.1:5000/api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_BUSINESS_ID=
WHATSAPP_BUSINESS_NAME=Maitrova
WHATSAPP_BUSINESS_TYPE=ecommerce
WHATSAPP_WABA_ID=
WHATSAPP_MESSAGES_PER_MINUTE=30
WHATSAPP_CHECKOUT_LINKS_PER_HOUR=10
