APP_NAME="AI Sales Employee API"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api

# Optional override. If omitted, MONGOOSE_URL from ../.env is reused.
# MONGODB_URL=mongodb://localhost:27017/appdb
MONGODB_DB_NAME=appdb

# Live MERN ecommerce database (server/.env MONGOOSE_URL and its database name)
ECOMMERCE_MONGODB_URL=mongodb://localhost:27017/appdb
ECOMMERCE_MONGODB_DB_NAME=appdb
# Public HTTPS base that serves catalogue files. Include /api/outputs when that is
# the route used by the ecommerce backend.
ECOMMERCE_PUBLIC_URL=https://api.yourstore.com/api/outputs
# Optional local path used to upload catalogue images directly to WhatsApp.
ECOMMERCE_OUTPUTS_PATH=
# Customer-facing website origin for product links (different from image/API origin).
ECOMMERCE_STOREFRONT_URL=https://www.yourstore.com
# Extra trusted CDN hosts for AI/WhatsApp image downloads, comma-separated.
REMOTE_IMAGE_ALLOWED_HOSTS=
REMOTE_IMAGE_MAX_BYTES=10485760

JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MERCHANT_PROMPT_VERSION=2026-10-01
MERCHANT_PROMPT_INSTRUCTIONS=
# Configure these from your provider price sheet; zero records tokens without estimating cost.
GEMINI_INPUT_COST_PER_MILLION=0
GEMINI_OUTPUT_COST_PER_MILLION=0
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Meta app secret; required to validate incoming POST webhooks.
WHATSAPP_APP_SECRET=
# Set the SAME random server-to-server secret here and in server/.env.
WHATSAPP_COMMERCE_KEY=
# Must target the backend used by ECOMMERCE_STOREFRONT_URL.
# For a deployed storefront, replace this local URL with its deployed API URL.
ECOMMERCE_API_URL=http://127.0.0.1:5000/api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_BUSINESS_ID=
WHATSAPP_BUSINESS_NAME=Maitrova
WHATSAPP_BUSINESS_TYPE=ecommerce
# Website chat tenant. Leave empty to share WHATSAPP_BUSINESS_ID.
STOREFRONT_BUSINESS_ID=
# Public website chat limits (0 disables a limit).
AI_CHAT_SESSION_MESSAGES_PER_MINUTE=20
AI_CHAT_SESSION_MESSAGES_PER_DAY=300
AI_CHAT_IP_MESSAGES_PER_MINUTE=60
AI_CHAT_IP_MESSAGES_PER_DAY=1500
# Website chat engine: rules (keyword routing) or tools (model-chosen lookups).
# While on rules, WEB_AGENT_ROLLOUT_PERCENT of browser sessions use tools.
WEB_AGENT_MODE=rules
# Backup Gemini models when the main one is rate-limited (free-tier quota is per model).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
WEB_AGENT_ROLLOUT_PERCENT=0
WHATSAPP_WABA_ID=
WHATSAPP_MESSAGES_PER_MINUTE=30
WHATSAPP_CHECKOUT_LINKS_PER_HOUR=10
# A team takeover pauses the AI; it resumes after this many hours without a team reply.
WHATSAPP_HANDOFF_IDLE_HOURS=12
# WhatsApp engine rollout: rules -> allowlist -> percentage -> tools (everyone).
WHATSAPP_AGENT_MODE=rules
WHATSAPP_AGENT_ALLOWLIST=
WHATSAPP_AGENT_ROLLOUT_PERCENT=0
# Meta-approved utility template for order updates outside the 24-hour window
# (body: {{1}} order number, {{2}} status, {{3}} total). Empty = updates only inside the window.
WHATSAPP_ORDER_UPDATE_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
